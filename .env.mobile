# Loaded only by `vite build --mode mobile` (npm run build:mobile, used by android:sync / ios:sync).
# The Android/iOS apps call the TaxVault API deployed as the Supabase Edge Function "api"
# (server/edge.ts). Not a secret: it is the public address of that function.
VITE_API_BASE_URL=https://egtmuxewuremxgodpjxj.supabase.co/functions/v1

# Payment-reminder push notifications. Set to true only after android/app/google-services.json
# (from your Firebase project) is in place: registering without it crashes the Android app.
VITE_PUSH_ENABLED=true
