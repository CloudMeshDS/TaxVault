# ----------------------------------------------------------------------------
# SERVER-ONLY SECRETS (never prefix these with VITE_: anything named VITE_* is
# bundled into the web app and the Android/iOS APK, where anyone can read it)
# ----------------------------------------------------------------------------

# Gemini key used by POST /api/receipt-ocr on the server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase service role key: required for password resets (server verifies the user's session).
SUPABASE_SERVICE_ROLE_KEY=""

# Razorpay secret and SMTP credentials (server only)
RAZORPAY_KEY_SECRET=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# ----------------------------------------------------------------------------
# SERVER CONFIG
# ----------------------------------------------------------------------------

# APP_URL: The URL where this app is hosted (also allowed for CORS).
APP_URL="http://localhost:3000"
# Extra comma-separated origins allowed to call /api (Capacitor origins are built in).
CORS_ORIGINS=""

SUPABASE_URL="https://egtmuxewuremxgodpjxj.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_zoLZwzgDSHO4TyJG1mbJTA_Hex4GU81"

# ----------------------------------------------------------------------------
# PUBLIC CLIENT CONFIG (safe to ship in the app bundle)
# ----------------------------------------------------------------------------

# Hosted TaxVault server for the Android/iOS builds (leave empty for the web app,
# which talks to the server it is served from). Example: https://api.taxvault.app
VITE_API_BASE_URL=""

# The anon key is public by design; data is protected only by Row Level Security.
# Apply supabase/migrations/2026-10-21_security_hardening.sql before going live.
VITE_SUPABASE_URL="https://egtmuxewuremxgodpjxj.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_zoLZwzgDSHO4TyJG1mbJTA_Hex4GU81"

VITE_RAZORPAY_KEY_ID=""

# EmailJS public identifiers (the EmailJS *private* key must not be set here)
VITE_EMAILJS_SERVICE_ID="service_xxxxxxx"
VITE_EMAILJS_TEMPLATE_ID="template_xxxxxxx"
VITE_EMAILJS_PUBLIC_KEY="xxxxxxx"
